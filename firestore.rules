rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Verified Users: For standard authenticated write operations
    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous' || request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role-based lookup: checks if current user acts with admin clearance
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Entity Validators ---
    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.name is string && data.name.size() <= 256 &&
        data.role in ['user', 'admin'] &&
        data.accounts is list && data.accounts.size() <= 10 &&
        data.cards is list && data.cards.size() <= 10 &&
        data.unreadNotifications is number && data.unreadNotifications >= 0 &&
        (!('savingsGoals' in data) || (data.savingsGoals is list && data.savingsGoals.size() <= 20)) &&
        (!('billers' in data) || (data.billers is list && data.billers.size() <= 20)) &&
        (!('supportTickets' in data) || (data.supportTickets is list && data.supportTickets.size() <= 20)) &&
        (!('legalFirstName' in data) || (data.legalFirstName is string && data.legalFirstName.size() <= 128)) &&
        (!('middleName' in data) || (data.middleName is string && data.middleName.size() <= 128)) &&
        (!('legalLastName' in data) || (data.legalLastName is string && data.legalLastName.size() <= 128)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 64)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 128)) &&
        (!('typeOfAccount' in data) || (data.typeOfAccount is string && data.typeOfAccount.size() <= 64)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 16)) &&
        (!('transactionPin' in data) || (data.transactionPin is string && data.transactionPin.size() <= 16)) &&
        (!('password' in data) || (data.password is string && data.password.size() <= 256)) &&
        (!('iban' in data) || (data.iban is string && data.iban.size() <= 64)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
        (!('registrationTimestamp' in data) || (data.registrationTimestamp is number)) &&
        (!('transactions' in data) || (data.transactions is list && data.transactions.size() <= 200)) &&
        (!('notifications' in data) || (data.notifications is list && data.notifications.size() <= 200));
    }

    function isValidTransaction(data) {
      return data.id is string && isValidId(data.id) &&
        data.description is string && data.description.size() <= 256 &&
        data.amount is number &&
        data.date is string && data.date.size() <= 64 &&
        data.timestamp is number &&
        data.category is string && data.category.size() <= 64;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.username is string && data.username.size() <= 128 &&
        data.action is string && data.action.size() <= 64 &&
        data.details is string && data.details.size() <= 2048 &&
        (data.status == 'success' || data.status == 'failed' || data.status == 'warning');
    }

    // --- Security Rules Rulesets ---

    // 1. Users Profile & Balance Sheet Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Transactions Nested Collection (Unbounded list isolation)
    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if true;
    }

    // 2b. Admins Collection & Subcollections for Administrative Staff
    match /admins/{userId} {
      allow read, write: if true;
    }

    match /admins/{userId}/transactions/{transactionId} {
      allow read, write: if true;
    }

    // 3. System-wide Audit Log Collections
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // 3b. System Configs Database (deposit instruction methods, etc.)
    match /system_configs/{configId} {
      allow read, write: if true;
    }

    // 4. Live Health & Sync Connection Telemetry
    match /test-connection-latency/{docId} {
      allow read, write: if true;
    }

    // 5. Global Pending Transactions Queue for administrative routing
    match /pending_transactions/{transactionId} {
      allow read, write: if true;
    }

  }
}
